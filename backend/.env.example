# ─── ResearchGuard AI Backend Configuration ──────────────────────────────
APP_NAME=ResearchGuard AI
APP_VERSION=2.0.0
DEBUG=True

# Authentication Security Secret
SECRET_KEY=researchguard-ai-secure-secret-key-2026-production-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_research_team

# Primary LLM Engine (Groq Llama 3.3 70B Versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Engine (Optional)
GEMINI_API_KEY=

# Academic & Web Discovery (Optional)
SEARCHAPI_KEY=

# Scholarly Providers (Optional API Keys)
# IEEE Xplore Official API Key (leave empty to gracefully skip)
IEEE_XPLORE_API_KEY=

# Mendeley OAuth (Optional personal library sync)
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=http://localhost:8000/api/auth/mendeley/callback

# Allowed CORS Origins
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
